# Adresa UniFi Access (konzole UDM/UCG/CK) – port 12445
UA_HOST=https://192.168.1.1:12445
# API token: UniFi Access > Settings > General > Advanced > API Token
UA_TOKEN=
# Konzole má self-signed certifikát -> false
UA_VERIFY_TLS=false
# Přihlášení do tohoto rozhraní
ADMIN_USER=admin
ADMIN_PASSWORD=zmen-me
